#!/usr/bin/env bash
# free-gjc — run gjc with the FREE starter profile (~/.gjc-free/agent).
# Bare `gjc` keeps using your normal ~/.gjc/agent profile, fully separate from this one.
#
# GJC_CODING_AGENT_DIR moves only the user agent dir (config.yml, models.yml,
# sessions, auth db). Project folders keep using `.gjc/`, so repo-local skills,
# rules and settings still load. (GJC_CONFIG_DIR would also rename the project
# folder to `.gjc-free/` and hide them.)
set -euo pipefail
export GJC_CODING_AGENT_DIR="${GJC_FREE_AGENT_DIR:-$HOME/.gjc-free/agent}"
unset PI_CODING_AGENT_DIR GJC_CONFIG_DIR PI_CONFIG_DIR
# Free-tier upstreams can take well over gjc's default 100s to emit the first
# token (reasoning models + queueing). Widen the stream watchdogs: first event
# 10min, idle 5min. Export your own values beforehand to override.
export PI_STREAM_FIRST_EVENT_TIMEOUT_MS="${PI_STREAM_FIRST_EVENT_TIMEOUT_MS:-600000}"
export PI_STREAM_IDLE_TIMEOUT_MS="${PI_STREAM_IDLE_TIMEOUT_MS:-300000}"
# Scrub inherited ANTHROPIC_* so this free profile never touches a paid Anthropic key.
while IFS='=' read -r _n _; do
  case "$_n" in ANTHROPIC_*) unset "$_n" || true ;; esac
done < <(env)
exec gjc "$@"
