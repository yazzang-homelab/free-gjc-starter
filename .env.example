# free-gjc-starter — 예시 환경변수 파일.
# gjc는 이 파일을 읽지 않습니다. 실제 키는 셸 환경변수(export / setx)에 넣으세요.
# 이 파일을 복사해 .env 로 쓰더라도 .gitignore 가 커밋을 막아줍니다.

# 서브에이전트(무료 :free 모델) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 폴백·방식 B 메인(DeepSeek V4.1 Flash / GLM-5.3) — https://build.nvidia.com  (nvapi-...)
NVIDIA_API_KEY=

# (선택) 맨 마지막 예비 DeepSeek V4.1 Flash — https://developer.amd.com.cn/radeon/tokenfactory
RADEON_API_KEY=

# 메인 Gemini(방식 A)는 키가 아니라 OAuth 로그인입니다 → free-gjc 실행 후 /login google-antigravity
